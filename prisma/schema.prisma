generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id                 String    @id @default(cuid())
  name               String    @default("Default workspace")
  stripeAccountId    String?
  lastSyncAt         DateTime?
  approveAboveCents  Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customers      Customer[]
  failedPayments FailedPayment[]
  recoveries     Recovery[]
}

model Customer {
  id               String   @id @default(cuid())
  workspaceId      String
  email            String
  name             String?
  stripeCustomerId String?
  createdAt        DateTime @default(now())

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  failedPayments FailedPayment[]

  @@unique([workspaceId, email])
}

model FailedPayment {
  id                    String   @id @default(cuid())
  workspaceId           String
  customerId            String?
  amountCents           Int
  currency              String   @default("usd")
  declineCode           String?
  stripeInvoiceId       String?
  stripePaymentIntentId String?
  status                String   @default("open")
  source                String   @default("stripe")
  failedAt              DateTime @default(now())
  createdAt             DateTime @default(now())

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  dunningAttempts DunningAttempt[]
  recovery        Recovery?
}

model DunningAttempt {
  id              String   @id @default(cuid())
  failedPaymentId String
  channel         String   @default("email")
  status          String   @default("pending")
  attemptedAt     DateTime @default(now())

  failedPayment FailedPayment @relation(fields: [failedPaymentId], references: [id], onDelete: Cascade)
}

model Recovery {
  id                String   @id @default(cuid())
  workspaceId       String
  failedPaymentId   String   @unique
  pendingApproval   Boolean  @default(false)
  approveAboveCents Int?
  recoveredCents    Int?
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  failedPayment FailedPayment @relation(fields: [failedPaymentId], references: [id], onDelete: Cascade)
}
